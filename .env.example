# Anthropic API Configuration (Claude)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI Configuration (Gemini)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (GPT-OSS & Qwen - FREE)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Mistral API Configuration (Ministral - FREE on the free plan)
# Get your key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# xAI API Configuration (Grok)
# Get your key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Server Configuration
PORT=3000

# ClickUp Integration (Optional)
# Note: ClickUp API tokens are entered directly in the UI for security
# Get your token from: ClickUp Settings > Apps > API Token

# Azure DevOps Integration (Optional)
# Note: Azure DevOps personal access tokens are entered directly in the UI, like ClickUp's
# Create one in Azure DevOps: User settings > Personal access tokens (Work Items: Read)

# OpenRouter API Configuration (GPT, DeepSeek, Kimi, Grok + 400 more)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
